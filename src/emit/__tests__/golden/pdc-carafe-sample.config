// nf-skyline-dia-ms configuration
// Generated by config-builder v1.0.0-test on 2026-01-15T12:00:00.000Z
// https://mriffle.github.io/nf-skyline-dia-ms-config-gui/

params {
    // ========================================================================
    // Input data (PDC)
    // ========================================================================
    // Study, file count, metadata, and optional batch assignments for runs that pull
    // spectra from the NCI Proteomic Data Commons.

    // PDC study ID — NCI Proteomic Data Commons study identifier. When set, the
    // workflow downloads spectra and metadata directly from PDC and bypasses the
    // general spectra inputs.
    pdc.study_id = 'PDC000504'

    // ========================================================================
    // Search engine
    // ========================================================================
    // Search-engine selection (EncyclopeDIA, DIA-NN, Cascadia, or none) plus
    // engine-specific parameters.

    // Search engine — Which search engine to run. PDC mode requires DIA-NN. Always
    // written to the generated config — this is a load-bearing parameter so we keep it
    // explicit.
    search_engine = 'diann'

    // ========================================================================
    // Spectral library
    // ========================================================================
    // Either a user-supplied spectral library or an optional Carafe library-generation
    // step performed before search.

    carafe {
        // Carafe: PDC random sample size — Randomly sample this many files from the main
        // PDC quant set as Carafe input. Subset of the main quant set, so no extra
        // downloads occur. Requires PDC mode.
        pdc_n_files = 5

        // Carafe CLI options — Extra Carafe command-line options. Do not set -mode,
        // -varMod, -maxVar, -ms, -db, -i, -se, -lf_type, or -device here; the workflow
        // manages those.
        cli_options = '-fdr 0.01 -ptm_site_prob 0.75 -ptm_site_qvalue 0.01 -itol 20 -itolu ppm -rf -rf_rt_win auto -cor 0.8 -min_mz 200 -n_ion_min 2 -c_ion_min 2 -enzyme 2 -miss_c 1 -fixMod 1 -clip_n_m -minLength 7 -maxLength 35 -min_pep_mz 300 -max_pep_mz 1800 -min_pep_charge 2 -max_pep_charge 4 -lf_frag_mz_min 200 -lf_frag_mz_max 1800 -lf_top_n_frag 20 -lf_min_n_frag 2 -lf_frag_n_min 2 -tf all -nm -nf 4 -min_n 4 -valid -na 0 -ez -fast'

        // Include phosphorylation — Add phosphorylation as a variable modification in the
        // generated library.
        include_phosphorylation = true
    }

    // ========================================================================
    // Skyline document
    // ========================================================================
    // Skyline document, template, report, and protein-grouping options. (Background
    // FASTA lives in Essentials at the top of the form.)

    skyline {
        // Group proteins — Enable Skyline protein grouping.
        group_proteins = true

        // Group by gene — Group Skyline proteins by gene name.
        group_by_gene = false

        // Protein parsimony — Apply Skyline protein parsimony to remove redundant protein
        // assignments.
        protein_parsimony = false
    }

    // ========================================================================
    // QC and batch reports
    // ========================================================================
    // QC-report content and normalization plus the separate batch-effect / covariate
    // report.

    // Skip QC report — Skip QC-report generation. The builder defaults this to off so
    // QC runs unless you opt out.
    qc_report.skip = false
}
