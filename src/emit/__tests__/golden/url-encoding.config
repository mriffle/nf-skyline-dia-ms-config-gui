// nf-skyline-dia-ms configuration
// Generated by config-builder v1.0.0-test on 2026-01-15T12:00:00.000Z
// https://mriffle.github.io/nf-skyline-dia-ms-config-gui/

params {
    // ========================================================================
    // Essentials
    // ========================================================================
    // Background protein database used by the search engines. Required for DIA-NN and
    // EncyclopeDIA; Cascadia generates its own.

    // Background FASTA — Protein sequence database (.fasta / .fa). Required for DIA-NN
    // and EncyclopeDIA. Cascadia generates its own FASTA from identifications.
    fasta = '/data/My Lab/db.fasta'

    // ========================================================================
    // Input data (general)
    // ========================================================================
    // Quantitative spectra, optional empirical-library spectra (narrow-window GPF,
    // pooled samples, or a subset of the search files), vendor RAW handling, and random
    // sampling for the standard (non-PDC) input path.

    // Quantitative spectra — Wide-window DIA spectra to quantify. Accepts a single
    // path, a list of paths, or a named batch map. Local paths and Panorama WebDAV URLs
    // are supported.
    quant_spectra_dir = 'https://panoramaweb.org/_webdav/My%20Lab/@files/run%20a.raw'

    // ========================================================================
    // Search engine
    // ========================================================================
    // Search-engine selection (EncyclopeDIA, DIA-NN, Cascadia, or none) plus
    // engine-specific parameters.

    // Search engine — Which search engine to run. PDC mode requires DIA-NN. Always
    // written to the generated config — this is a load-bearing parameter so we keep it
    // explicit.
    search_engine = 'diann'

    diann {
        // DIA-NN search parameters — Command-line flags appended to DIA-NN search
        // invocations.
        search_params = '--qvalue 0.01'

        // DIA-NN FASTA digest parameters — Flags used when DIA-NN predicts a library from
        // the FASTA. Controls enzyme, missed cleavages, peptide-length and charge bounds.
        fasta_digest_params = '--cut \'K*,R*,!*P\' --unimod4 --missed-cleavages 1 --min-pep-len 8 --min-pr-charge 2 --max-pep-len 30'
    }

    // ========================================================================
    // Skyline document
    // ========================================================================
    // Skyline document, template, report, and protein-grouping options. (Background
    // FASTA lives in Essentials at the top of the form.)

    skyline {
        // Skyline .skyr report files — One or more Skyline report-template (.skyr) files to
        // apply at the end of the workflow. Local path or authenticated Panorama URL.
        skyr_file = ['https://panoramaweb.org/_webdav/A%20B/report.skyr', '/local/A B/report.skyr']

        // Group proteins — Enable Skyline protein grouping.
        group_proteins = true

        // Group by gene — Group Skyline proteins by gene name.
        group_by_gene = false

        // Protein parsimony — Apply Skyline protein parsimony to remove redundant protein
        // assignments.
        protein_parsimony = false
    }

    // ========================================================================
    // QC and batch reports
    // ========================================================================
    // QC-report content and normalization plus the separate batch-effect / covariate
    // report.

    qc_report {
        // Skip QC report — Skip QC-report generation. The builder defaults this to off so
        // QC runs unless you opt out.
        skip = false

        // QC report format — Which QC report formats to render. At least one of HTML or PDF
        // must be selected; defaults to HTML only.
        report_format = ['html']
    }

    // ========================================================================
    // Panorama upload
    // ========================================================================
    // Upload converted spectra, search outputs, FASTA, library, and Skyline documents
    // to PanoramaWeb.

    panorama {
        // Upload to Panorama — Upload converted spectra, search outputs, FASTA, library,
        // Skyline documents, and reports to PanoramaWeb at the end of the run.
        upload = true

        // Panorama upload URL — WebDAV URL of the Panorama folder that will receive
        // uploaded files.
        upload_url = 'https://panoramaweb.org/_webdav/My%20Lab/%40files/'
    }
}

// ========================================================================
// Execution profile
// ========================================================================
// This is the standard profile — Nextflow applies it automatically when you run
// without a -profile option, so these settings take effect by default.
// resourceLimits caps the CPUs, memory, and walltime any single task may request —
// edit them to match the machine you run on. The workflow also ships slurm and
// awsbatch profiles; pass e.g. `-profile slurm` to use one instead.
profiles {
    standard {
        process.executor = 'local'

        // Cap on the resources any single task may request.
        process.resourceLimits = [ cpus: 8, memory: '12.GB', time: '240.h' ]

        // Where msconvert mzML output and downloaded Panorama files
        // are cached between runs.
        params.mzml_cache_directory = 'mzml_cache'
        params.panorama_cache_directory = 'raw_cache'
    }
}
