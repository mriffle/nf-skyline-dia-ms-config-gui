// nf-skyline-dia-ms configuration
// Generated by config-builder v1.0.0-test on 2026-01-15T12:00:00.000Z
// https://mriffle.github.io/nf-skyline-dia-ms/

params {
    // ========================================================================
    // Input data (general)
    // ========================================================================
    // Quantitative spectra, optional chromatogram-library spectra, vendor RAW handling,
    // and random sampling for the standard (non-PDC) input path.

    // Quantitative spectra — Wide-window DIA spectra to quantify. Accepts a single
    // path, a list of paths, or a named batch map. Local paths and Panorama WebDAV URLs
    // are supported.
    quant_spectra_dir = '/data/wide'

    // ========================================================================
    // Search engine
    // ========================================================================
    // Search-engine selection (EncyclopeDIA, DIA-NN, Cascadia, or none) plus
    // engine-specific parameters.

    // Search engine — Which search engine to run. PDC mode requires DIA-NN. Always
    // written to the generated config — this is a load-bearing parameter so we keep it
    // explicit.
    search_engine = 'cascadia'

    cascadia {
        // Cascadia: use GPU — Enable GPU acceleration for Cascadia. Requires a CUDA-capable
        // device in the execution environment.
        use_gpu = true

        // Cascadia: score threshold — Minimum prediction score retained after Cascadia
        // inference. Value between 0 and 1.
        score_threshold = 0.85
    }
}
